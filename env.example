# Neon → Project → Connection string (pooled)
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Vercel → Storage → Blob → connect to this project (adds this automatically)
BLOB_READ_WRITE_TOKEN=
# Your login PIN
APP_PIN=1234
# Any long random string (openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string
# Anthropic API key — reads receipts (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# Optional: model used to read receipts
RECEIPT_MODEL=claude-haiku-4-5
